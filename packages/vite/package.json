{
  "name": "browser-vite",
  "version": "8.1.5-browser.1",
  "license": "MIT",
  "author": "Evan You",
  "description": "Native-ESM powered web dev build tool - Browser Edition (Vite 8.1.5)",
  "keywords": [
    "build-tool",
    "dev-server",
    "framework",
    "frontend",
    "hmr",
    "vite",
    "browser"
  ],
  "bin": {
    "vite": "bin/vite.js"
  },
  "main": "dist/node/index.js",
  "browser": "dist/browser/index.js",
  "types": "dist/node/index.d.ts",
  "type": "module",
  "imports": {
    "#module-sync-enabled": {
      "module-sync": "./misc/true.js",
      "default": "./misc/false.js"
    },
    "#types/*": "./types/*.d.ts",
    "#dep-types/*": "./src/types/*.d.ts"
  },
  "exports": {
    ".": {
      "browser": "./dist/browser/index.js",
      "import": "./dist/node/index.js",
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./module-runner": "./dist/node/module-runner.js",
    "./internal": "./dist/node/internal.js",
    "./dist/client/*": "./dist/client/*",
    "./dist/browser/*": "./dist/browser/*",
    "./types/*": {
      "types": "./types/*"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "misc/**/*.js",
    "client.d.ts",
    "types"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BLamy/browser-vite-6.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/BLamy/browser-vite-6/issues"
  },
  "homepage": "https://github.com/BLamy/browser-vite-6#readme",
  "scripts": {
    "dev": "premove dist && pnpm build-bundle -w",
    "build": "premove dist && pnpm build-bundle && pnpm build-browser && pnpm build-types",
    "build-bundle": "rolldown --config rolldown.config.ts",
    "build-browser": "rolldown --config rolldown.config.browser.ts",
    "build-types": "pnpm build-types-roll && pnpm build-types-check",
    "build-types-roll": "rolldown --config rolldown.dts.config.ts",
    "build-types-check": "tsc --project tsconfig.check.json",
    "ci-build": "premove dist && pnpm build-bundle && pnpm build-browser",
    "typecheck": "tsc && tsc -p src/node && tsc -p src/client && tsc -p src/module-runner && tsc -p src/shared",
    "lint": "eslint --cache --ext .ts src/**",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "es-module-lexer": "^2.3.1",
    "lightningcss": "^1.32.0",
    "oxc-transform": "^0.108.0",
    "picomatch": "^4.0.5",
    "postcss": "^8.5.17",
    "rolldown": "~1.1.5",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@oxc-transform/binding-wasm32-wasi": "^0.108.0",
    "@types/node": "^22.10.0",
    "premove": "^4.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@types/node": "^20.19.0 || >=22.12.0",
    "esbuild": "^0.27.0 || ^0.28.0",
    "less": "^4.0.0",
    "sass": "^1.70.0",
    "sass-embedded": "^1.70.0",
    "stylus": ">=0.54.8",
    "sugarss": "^5.0.0",
    "terser": "^5.16.0"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "sass": {
      "optional": true
    },
    "sass-embedded": {
      "optional": true
    },
    "stylus": {
      "optional": true
    },
    "less": {
      "optional": true
    },
    "sugarss": {
      "optional": true
    },
    "terser": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "fsevents": "~2.3.3"
  },
  "//": "UPSTREAM_VITE_VERSION=8.1.5 — see docs/UPSTREAM.md for bump process"
}
